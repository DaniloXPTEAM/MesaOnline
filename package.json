{
  "name": "modernrpg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:visual-lock": "node scripts/check-visual-lock.mjs",
    "build": "npm run check:visual-lock && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run check:visual-lock && vitest run",
    "test:e2e": "playwright test",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^4.8.69",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "express": "^4.22.3",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "peer": "^1.0.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.4.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
